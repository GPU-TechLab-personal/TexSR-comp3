# Copy to .env (same folder) and edit for this machine. .env is not committed.
#   cp .env.example .env
#
# DAS_ROOT: the data drive. It must hold
#   MatSynth/data/*.parquet   MatSynth as downloaded (COMMANDS.txt [2])
#   TexSR-data/               everything derived from it (COMMANDS.txt [4]): evaluation set,
#                             training pairs, grouped TFRecord, baseline checkpoints
# Inside the containers it is /data (/data/MatSynth/..., /data/TexSR-data/...).
# Windows + Docker Desktop: forward slashes; the drive must be shared with Docker.
DAS_ROOT=D:/
