# everything a run produces (checkpoints, caches, logs, outputs) ...
runs/*
# ... except the evaluation summaries (numbers and tables) and the montages, so
# results travel with git: runs/eval/<experiment>/<checkpoint>/{report.json,summary.md,montage/}
# (the SR maps under runs/eval/<experiment>/<checkpoint>/maps/ stay local)
!runs/eval/
runs/eval/*
!runs/eval/*/
runs/eval/*/*
!runs/eval/*/*/
runs/eval/*/*/*
!runs/eval/*/*/report.json
!runs/eval/*/*/summary.md
!runs/eval/*/*/montage/
# data lives outside the repository (D:/TexSR-data, see COMMANDS.txt)
# host-specific
docker/.env
# weights fetched at setup
*.pth
*.ckpt
*.pt
*.safetensors
__pycache__/
*.pyc
